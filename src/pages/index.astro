---
const title = "TDS Simulator — Mauritius Rental Tax Calculator";
const description = "Calculate Tax Deduction at Source (TDS) on rental income in Mauritius. Compare company vs individual lease — owner fiscal impact, MRA credit, net cash flow. Free, instant, based on MRA TDS Guide 2025.";
const url = "https://tds.qontab.com";
const ogImage = `${url}/og.png`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="keywords" content="TDS Mauritius, Tax Deduction at Source, MRA, rental tax Mauritius, simulateur TDS Maurice, bail société Maurice, impôt loyer île Maurice"/>
  <link rel="canonical" href={url}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={url}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:locale" content="en_MU"/>
  <meta property="og:site_name" content="Qontab"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImage}/>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": title,
    "url": url,
    "description": description,
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "MUR" },
    "publisher": { "@type": "Organization", "name": "Qontab", "url": "https://qontab.com" }
  })}></script>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer"/>

  <style>
    :root {
      --bg:        #f7f8fb;
      --surface:   #ffffff;
      --border:    #e3e6f0;
      --border-2:  #cbd0e8;
      --accent:    #5b51e8;
      --accent-bg: rgba(91,81,232,0.07);
      --accent-bd: rgba(91,81,232,0.2);
      --teal:      #0a9e87;
      --teal-bg:   rgba(10,158,135,0.07);
      --teal-bd:   rgba(10,158,135,0.2);
      --red:       #d0404f;
      --green:     #1a8f5e;
      --text:      #1a1d2e;
      --text-2:    #52577a;
      --text-3:    #9097b8;
      --r:         14px;
      --rs:        9px;
      --sh:        0 1px 3px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.04);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ── TOPBAR ── */
    .topbar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 13px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .topbar-brand { display: flex; align-items: center; gap: 9px; }
    .topbar-icon {
      width: 32px; height: 32px;
      background: var(--accent-bg); border: 1px solid var(--accent-bd);
      border-radius: 8px; display: flex; align-items: center; justify-content: center;
      color: var(--accent); font-size: 0.8rem; flex-shrink: 0;
    }
    .topbar-title { font-size: 0.9rem; font-weight: 700; letter-spacing: -0.01em; }
    .topbar-sub   { font-size: 0.67rem; color: var(--text-3); margin-top: 1px; }
    .mra-btn {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 0.72rem; font-weight: 500; color: var(--text-2);
      text-decoration: none; background: var(--bg);
      border: 1px solid var(--border-2); border-radius: 7px;
      padding: 7px 11px; transition: all 0.15s; white-space: nowrap; flex-shrink: 0;
    }
    .mra-btn:hover { border-color: var(--accent); color: var(--accent); }

    /* ── VIEWS ── */
    .page { max-width: 840px; margin: 0 auto; padding: 24px 16px 64px; }

    /* Two views: simulator and results */
    .view { display: none; }
    .view.active { display: block; }

    /* On desktop — both always visible, side by side */
    @media (min-width: 720px) {
      .view { display: block !important; }
      .desktop-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .full { grid-column: 1 / -1; }
      .back-btn { display: none !important; }
      .calc-btn { display: none !important; }
    }

    /* ── BACK BUTTON ── */
    .back-btn {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 0.8rem; font-weight: 600; color: var(--text-2);
      background: none; border: none; cursor: pointer;
      padding: 0; margin-bottom: 16px; font-family: 'Inter', sans-serif;
      transition: color 0.15s;
    }
    .back-btn:hover { color: var(--accent); }

    /* ── CARD ── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r);
      padding: 20px;
      box-shadow: var(--sh);
      margin-bottom: 12px;
    }
    .card:last-child { margin-bottom: 0; }
    .card-title {
      font-size: 0.67rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--text-3); margin-bottom: 18px;
      display: flex; align-items: center; gap: 6px;
    }

    /* ── FIELD ── */
    .field { margin-bottom: 16px; }
    .field:last-child { margin-bottom: 0; }
    .field-label {
      font-size: 0.78rem; font-weight: 600; color: var(--text);
      margin-bottom: 7px; display: flex; align-items: center; gap: 6px;
    }
    .field-label i { color: var(--text-3); font-size: 0.72rem; }
    .field-hint { font-size: 0.68rem; color: var(--text-3); margin-top: 5px; line-height: 1.5; }

    input[type=number] {
      width: 100%; background: var(--bg);
      border: 1.5px solid var(--border-2); border-radius: var(--rs);
      color: var(--text); font-family: 'Inter', sans-serif;
      font-size: 1.15rem; font-weight: 700;
      padding: 12px 14px; outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      -moz-appearance: textfield; min-height: 50px;
    }
    input[type=number]::-webkit-inner-spin-button { display: none; }
    input[type=number]:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(91,81,232,0.1);
    }

    .section-sep { border: none; border-top: 1px solid var(--border); margin: 16px 0; }
    .section-label {
      font-size: 0.65rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--text-3); margin-bottom: 12px;
      display: flex; align-items: center; gap: 6px;
    }

    /* ── TOGGLE ── */
    .toggle-group { display: flex; gap: 6px; }
    .toggle-btn {
      flex: 1; min-height: 46px; padding: 8px 8px;
      border-radius: var(--rs); border: 1.5px solid var(--border-2);
      background: var(--bg); color: var(--text-2);
      font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 500;
      cursor: pointer;
      transition: border-color 0.18s ease, background 0.18s ease,
                  color 0.18s ease, box-shadow 0.18s ease, transform 0.1s ease;
      display: flex; align-items: center; justify-content: center; gap: 5px;
      position: relative; overflow: hidden;
    }
    .toggle-btn:hover:not(.active) {
      border-color: var(--accent); color: var(--accent); background: var(--accent-bg);
    }
    .toggle-btn:active { transform: scale(0.97); }
    .toggle-btn.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(91,81,232,0.28);
    }
    .toggle-btn.active.teal {
      background: var(--teal);
      color: #fff;
      border-color: var(--teal);
      box-shadow: 0 2px 8px rgba(10,158,135,0.28);
    }
    /* Keep pills readable on active white-text button */
    .toggle-btn.active .pill-red   { background: rgba(255,255,255,0.2); color: #fff; }
    .toggle-btn.active .pill-green { background: rgba(255,255,255,0.2); color: #fff; }
    .pill { font-size: 0.6rem; font-weight: 700; padding: 1px 6px; border-radius: 99px; }
    .pill-red   { background: rgba(208,64,79,0.1);  color: var(--red); }
    .pill-green { background: rgba(26,143,94,0.1);  color: var(--green); }

    /* ── CALCULATE BUTTON ── */
    .calc-btn {
      width: 100%; padding: 14px;
      background: var(--accent); color: #fff;
      border: none; border-radius: var(--rs);
      font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 600;
      cursor: pointer; margin-top: 6px;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: background 0.15s;
    }
    .calc-btn:hover { background: #4a41cc; }

    /* ── MODE BANNER ── */
    .mode-banner {
      display: flex; align-items: center; gap: 7px;
      padding: 9px 12px; border-radius: var(--rs);
      font-size: 0.78rem; font-weight: 600; margin-bottom: 14px;
    }
    .mode-banner.societe { background: var(--accent-bg); color: var(--accent); border: 1px solid var(--accent-bd); }
    .mode-banner.perso   { background: var(--teal-bg);   color: var(--teal);   border: 1px solid var(--teal-bd); }

    /* ── RESULT BLOCKS ── */
    .rblock { border-radius: var(--rs); padding: 13px 14px; margin-bottom: 10px; }
    .rblock:last-child { margin-bottom: 0; }
    .rblock.b-accent { background: var(--accent-bg); border: 1px solid var(--accent-bd); }
    .rblock.b-teal   { background: var(--teal-bg);   border: 1px solid var(--teal-bd); }
    .rblock.b-amber  { background: rgba(196,125,16,0.06); border: 1px solid rgba(196,125,16,0.18); }

    .block-title {
      font-size: 0.66rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 10px; display: flex; align-items: center; gap: 5px;
    }
    .block-title.c-accent { color: var(--accent); }
    .block-title.c-teal   { color: var(--teal); }
    .block-title.c-amber  { color: #c47d10; }

    .rrow {
      display: flex; justify-content: space-between; align-items: baseline;
      gap: 8px; padding: 5px 0; font-size: 0.82rem;
    }
    .rrow + .rrow { border-top: 1px solid rgba(0,0,0,0.05); }
    .rrow.strong .lbl,
    .rrow.strong .val { font-weight: 700; }
    .rrow .lbl { color: var(--text-2); flex: 1; min-width: 0; }
    .rrow .sub { font-size: 0.66rem; color: var(--text-3); display: block; margin-top: 1px; }
    .rrow .val { font-weight: 600; white-space: nowrap; color: var(--text); flex-shrink: 0; }
    .rrow.indent .lbl { padding-left: 12px; color: var(--text-3); font-size: 0.77rem; }
    .rrow.indent .val { font-size: 0.77rem; }

    .v-red   { color: var(--red)    !important; }
    .v-green { color: var(--green)  !important; }
    .v-muted { color: var(--text-3) !important; }

    /* ── COMPARE ── */
    .compare-cols { display: flex; flex-direction: column; gap: 10px; margin-bottom: 10px; }
    @media (min-width: 560px) {
      .compare-cols { flex-direction: row; }
      .compare-cols > * { flex: 1; min-width: 0; }
    }

    .div-row { border: none; border-top: 1px dashed var(--border-2); margin: 5px 0; }

    .note {
      font-size: 0.71rem; color: var(--text-3); line-height: 1.65;
      margin-top: 12px; border-left: 2px solid var(--border-2); padding-left: 11px;
    }
    .note strong { color: var(--text-2); }
    .note a { color: var(--text-3); }
    .note a:hover { color: var(--accent); }

    /* ── FOOTER ── */
    .footer {
      max-width: 840px; margin: 0 auto;
      padding: 20px 16px 32px;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 10px;
      border-top: 1px solid var(--border);
      font-size: 0.71rem; color: var(--text-3);
    }
    .footer a { color: var(--text-3); text-decoration: none; }
    .footer a:hover { color: var(--accent); }
    .qontab-badge {
      display: inline-flex; align-items: center; gap: 5px;
      background: var(--surface); border: 1px solid var(--border-2);
      border-radius: 7px; padding: 6px 11px; font-weight: 600; transition: all 0.15s;
    }
    .qontab-badge:hover { border-color: var(--accent); color: var(--accent); }
  </style>
</head>
<body>

<header class="topbar">
  <div class="topbar-brand">
    <span class="topbar-icon"><i class="fa-solid fa-landmark"></i></span>
    <div>
      <div class="topbar-title">TDS Simulator</div>
      <div class="topbar-sub">Mauritius Rental Tax · MRA 2025</div>
    </div>
  </div>
  <a class="mra-btn" href="https://www.mra.mu/download/TDSGuide.pdf" target="_blank" rel="noopener">
    <i class="fa-solid fa-file-lines"></i> MRA Guide <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:0.6rem"></i>
  </a>
</header>

<div class="page">
  <div class="desktop-grid">

    <!-- ── VIEW 1 : SIMULATOR ── -->
    <div class="view active" id="view-sim">
      <div class="card">
        <div class="card-title"><i class="fa-solid fa-sliders"></i> Simulator</div>

        <div class="field">
          <div class="field-label"><i class="fa-solid fa-coins"></i> Monthly gross rent (MUR)</div>
          <input type="number" id="loyer" value="60000" min="0" step="1000" onfocus="if(this.value==='60000'){this.value='';this.select()}" onblur="if(this.value===''){this.value='60000'}"/>
        </div>

        <div class="field">
          <div class="field-label"><i class="fa-solid fa-building-user"></i> Tenant type</div>
          <div class="toggle-group">
            <button class="toggle-btn active" id="btn-societe" onclick="setMode('societe')">
              <i class="fa-solid fa-building"></i> Company <span class="pill pill-red">TDS</span>
            </button>
            <button class="toggle-btn" id="btn-perso" onclick="setMode('perso')">
              <i class="fa-solid fa-person"></i> Individual <span class="pill pill-green">No TDS</span>
            </button>
            <button class="toggle-btn" id="btn-mixte" onclick="setMode('mixte')">
              <i class="fa-solid fa-shuffle"></i> Mixed
            </button>
          </div>
        </div>

        <div class="field" id="field-split" style="display:none">
          <div class="field-label"><i class="fa-solid fa-sliders"></i> Company share <span id="split-label" style="margin-left:4px;color:var(--accent);font-weight:700">50%</span></div>
          <input type="range" id="splitPct" min="0" max="100" step="5" value="50" oninput="onSplitChange()" style="width:100%;accent-color:var(--accent);cursor:pointer;margin-top:2px"/>
          <div style="display:flex;justify-content:space-between;font-size:0.68rem;color:var(--text-3);margin-top:5px">
            <span>0% — No TDS</span>
            <span id="split-desc">50% company · 50% individual</span>
            <span>100% — Full TDS</span>
          </div>
        </div>

        <div class="field">
          <div class="field-label"><i class="fa-solid fa-house"></i> Owner residency</div>
          <div class="toggle-group">
            <button class="toggle-btn active" id="btn-resident" onclick="setOwner('resident')">
              <i class="fa-solid fa-flag"></i> Resident <small style="font-size:0.68rem;opacity:0.6">7.5%</small>
            </button>
            <button class="toggle-btn" id="btn-nonresident" onclick="setOwner('nonresident')">
              <i class="fa-solid fa-earth-africa"></i> Non-resident <small style="font-size:0.68rem;opacity:0.6">10%</small>
            </button>
          </div>
        </div>

        <hr class="section-sep"/>
        <div class="section-label"><i class="fa-solid fa-user-tie"></i> Owner fiscal profile</div>

        <div class="field">
          <div class="field-label"><i class="fa-solid fa-briefcase"></i> Other annual income (MUR)</div>
          <input type="number" id="otherIncome" value="0" min="0" step="50000"/>
          <div class="field-hint">Salary, business — excluding this rental</div>
        </div>

        <div class="field">
          <div class="field-label"><i class="fa-solid fa-users"></i> Tax category</div>
          <div class="toggle-group">
            <button class="toggle-btn active" id="btn-catA" onclick="setCategory('A')">
              <i class="fa-solid fa-user"></i> Cat. A <small style="font-size:0.68rem;opacity:0.6">Rs 390k</small>
            </button>
            <button class="toggle-btn" id="btn-catB" onclick="setCategory('B')">
              <i class="fa-solid fa-user-plus"></i> Cat. B <small style="font-size:0.68rem;opacity:0.6">Rs 500k+</small>
            </button>
          </div>
          <div class="field-hint">Cat. A = single · Cat. B = with dependents (estimate)</div>
        </div>

        <button class="calc-btn" onclick="showResults()">
          <i class="fa-solid fa-chart-pie"></i> See Results
        </button>
      </div>
    </div>

    <!-- ── VIEW 2 : RESULTS ── -->
    <div class="view" id="view-results">

      <button class="back-btn" onclick="showSim()">
        <i class="fa-solid fa-arrow-left"></i> Edit parameters
      </button>

      <div class="card">
        <div class="card-title"><i class="fa-solid fa-chart-pie"></i> Results</div>

        <div id="modeBanner" class="mode-banner societe">
          <i class="fa-solid fa-circle-check"></i>
          <span id="bannerText">Company lease — TDS 7.5%</span>
        </div>

        <div class="rblock b-accent">
          <div class="block-title c-accent"><i class="fa-solid fa-building"></i> Tenant — monthly</div>
          <div class="rrow"><span class="lbl">Gross rent</span><span class="val" id="r-brut">—</span></div>
          <div class="rrow" id="row-split" style="display:none">
            <span class="lbl">Company portion <span class="sub" id="r-split-pct">50%</span></span>
            <span class="val" id="r-split-amt">—</span>
          </div>
          <div class="rrow" id="row-tds">
            <span class="lbl">TDS withheld <span class="sub" id="r-tds-rate">7.5%</span></span>
            <span class="val v-red" id="r-tds">—</span>
          </div>
          <div class="rrow" id="row-remise">
            <span class="lbl">→ Remitted to MRA <span class="sub">before 20th</span></span>
            <span class="val v-red" id="r-remise">—</span>
          </div>
          <div class="rrow strong"><span class="lbl">Net to owner</span><span class="val v-green" id="r-net">—</span></div>
        </div>

        <div class="rblock b-teal">
          <div class="block-title c-teal"><i class="fa-solid fa-key"></i> Owner — annual</div>
          <div class="rrow"><span class="lbl">Rental / yr</span><span class="val" id="r-rental-annual">—</span></div>
          <div class="rrow"><span class="lbl">Other income / yr</span><span class="val v-muted" id="r-other-income">—</span></div>
          <div class="rrow strong"><span class="lbl">Total income</span><span class="val" id="r-total-income">—</span></div>
          <hr class="div-row"/>
          <div class="rrow"><span class="lbl">Tax on total <span class="sub">MRA approx.</span></span><span class="val v-red" id="r-tax-total">—</span></div>
          <div class="rrow indent"><span class="lbl"><i class="fa-solid fa-arrow-right" style="font-size:0.58rem"></i> Marginal on rental</span><span class="val v-red" id="r-tax-rental">—</span></div>
          <div class="rrow" id="row-credit"><span class="lbl">TDS credit</span><span class="val v-green" id="r-credit">—</span></div>
          <div class="rrow strong"><span class="lbl">Net tax to settle</span><span class="val" id="r-nettax">—</span></div>
          <div class="rrow indent"><span class="lbl">Effective rate</span><span class="val v-muted" id="r-effrate">—</span></div>
          <hr class="div-row"/>
          <div class="rrow strong"><span class="lbl">Net cash-in / yr</span><span class="val v-green" id="r-cashowner">—</span></div>
        </div>
      </div>

      <!-- COMPARE -->
      <div class="card full">
        <div class="card-title"><i class="fa-solid fa-scale-balanced"></i> Company vs Individual</div>

        <div class="compare-cols">
          <div class="rblock b-accent" style="flex:1;min-width:0">
            <div class="block-title c-accent"><i class="fa-solid fa-building"></i> Company lease</div>
            <div class="rrow"><span class="lbl">Monthly to owner</span><span class="val" id="c-net-soc">—</span></div>
            <div class="rrow"><span class="lbl">TDS → MRA / yr</span><span class="val v-red" id="c-tds-soc">—</span></div>
            <div class="rrow"><span class="lbl">Net tax / yr</span><span class="val" id="c-tax-soc">—</span></div>
            <div class="rrow strong"><span class="lbl">Cash-in / yr</span><span class="val v-green" id="c-cash-soc">—</span></div>
          </div>
          <div class="rblock b-teal" style="flex:1;min-width:0">
            <div class="block-title c-teal"><i class="fa-solid fa-person"></i> Individual lease</div>
            <div class="rrow"><span class="lbl">Monthly to owner</span><span class="val" id="c-net-per">—</span></div>
            <div class="rrow"><span class="lbl">TDS → MRA / yr</span><span class="val v-muted" id="c-tds-per">—</span></div>
            <div class="rrow"><span class="lbl">Net tax / yr</span><span class="val" id="c-tax-per">—</span></div>
            <div class="rrow strong"><span class="lbl">Cash-in / yr</span><span class="val v-green" id="c-cash-per">—</span></div>
          </div>
        </div>

        <div class="rblock b-amber">
          <div class="block-title c-amber"><i class="fa-solid fa-arrow-right-arrow-left"></i> Differential</div>
          <div class="rrow">
            <span class="lbl">Annual cash-in advantage<span class="sub">TDS = tax advance · recoverable if TDS &gt; tax due</span></span>
            <span class="val" id="diff-owner">—</span>
          </div>
          <div class="rrow">
            <span class="lbl">Tenant gross cost</span>
            <span class="val v-muted">Identical — TDS is tax routing, not an extra charge</span>
          </div>
        </div>

        <p class="note">
          <strong>Model:</strong> Rs 390k exemption (Cat. A) · Rs 500k (Cat. B, estimate) · 15% flat · +5% solidarity above Rs 3M.
          TDS not applicable if tenant turnover &lt; Rs 6M or tax &lt; Rs 500.
          Source: <a href="https://www.mra.mu/download/TDSGuide.pdf" target="_blank" rel="noopener">MRA TDS Guide 2025</a>.
        </p>
      </div>

    </div><!-- /view-results -->

  </div><!-- /desktop-grid -->
</div><!-- /page -->

<footer class="footer">
  <span>Based on <a href="https://www.mra.mu" target="_blank" rel="noopener">MRA</a> data · For informational purposes only.</span>
  <a class="qontab-badge" href="https://qontab.com" target="_blank" rel="noopener">
    <i class="fa-solid fa-chart-column"></i> Qontab
  </a>
</footer>

<script is:inline>
let mode = 'societe', ownerType = 'resident', taxCategory = 'A';

function showResults() {
  update();
  document.getElementById('view-sim').classList.remove('active');
  document.getElementById('view-results').classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
function showSim() {
  document.getElementById('view-results').classList.remove('active');
  document.getElementById('view-sim').classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function mauritiusTax(income, category) {
  if (income <= 0) return 0;
  const exempt = category === 'B' ? 500000 : 390000;
  let tax = Math.max(0, income - exempt) * 0.15;
  if (income > 3000000) tax += (income - 3000000) * 0.05;
  return Math.max(0, tax);
}

function setMode(m) {
  mode = m;
  ['societe','perso','mixte'].forEach(x => {
    const btn = document.getElementById('btn-'+x);
    if (btn) btn.classList.toggle('active', m === x);
  });
  // Show/hide split slider
  const splitField = document.getElementById('field-split');
  if (splitField) splitField.style.display = (m === 'mixte') ? 'block' : 'none';
}

function onSplitChange() {
  const v = parseInt(document.getElementById('splitPct').value);
  document.getElementById('split-label').textContent = v + '%';
  const indv = 100 - v;
  document.getElementById('split-desc').textContent =
    v + '% company · ' + indv + '% individual';
}

function setOwner(o) {
  ownerType = o;
  ['resident','nonresident'].forEach(x => {
    const btn = document.getElementById('btn-'+x);
    btn.classList.toggle('active', o === x);
    btn.classList.toggle('teal', o === x && x === 'nonresident');
  });
}
function setCategory(c) {
  taxCategory = c;
  ['A','B'].forEach(x =>
    document.getElementById('btn-cat'+x).classList.toggle('active', c === x));
}

function fmt(n, suffix='') {
  return (n < 0 ? '− ' : '') + 'Rs\u00a0' + Math.abs(Math.round(n)).toLocaleString('fr-FR') + suffix;
}
function pct(n) { return (Math.round(n * 10) / 10) + '%'; }

// Returns TDS for a given loyer based on mode + split
function calcTDS(loyer, tdsRate, mode, splitPct) {
  if (mode === 'perso')   return 0;
  if (mode === 'societe') return loyer * tdsRate;
  // mixte: only the company portion triggers TDS
  return loyer * (splitPct / 100) * tdsRate;
}

function calcScenario(loyer, tdsRate, hasTDS, splitPct, otherIncome, category) {
  const annualRent = loyer * 12;
  // For compare we use fixed hasTDS bool; for main calc we use mode
  const companyShare = hasTDS === true ? 1 : hasTDS === false ? 0 : splitPct / 100;
  const annualTDS   = annualRent * companyShare * tdsRate;
  const netMonthly  = loyer - loyer * companyShare * tdsRate;
  const taxWith     = mauritiusTax(otherIncome + annualRent, category);
  const taxWithout  = mauritiusTax(otherIncome, category);
  const rentalTax   = Math.max(0, taxWith - taxWithout);
  const netTax      = Math.max(0, rentalTax - annualTDS);
  const annualCash  = annualRent - rentalTax;
  const effRate     = annualRent > 0 ? rentalTax / annualRent : 0;
  return { annualRent, annualTDS, netMonthly, taxWith, rentalTax, netTax, annualCash, effRate };
}

function set(id, val, cls) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent = val;
  if (cls !== undefined) el.className = 'val' + (cls ? ' ' + cls : '');
}

function update() {
  const loyer       = parseFloat(document.getElementById('loyer').value) || 0;
  const otherIncome = parseFloat(document.getElementById('otherIncome').value) || 0;
  const splitPct    = parseInt(document.getElementById('splitPct').value) || 50;
  const tdsRate     = ownerType === 'resident' ? 0.075 : 0.10;
  const tpct        = tdsRate * 100;

  // Banner
  const banner = document.getElementById('modeBanner');
  const bannerText = document.getElementById('bannerText');
  if (mode === 'societe') {
    banner.className = 'mode-banner societe';
    bannerText.textContent = `Company lease — TDS ${tpct}%`;
  } else if (mode === 'perso') {
    banner.className = 'mode-banner perso';
    bannerText.textContent = 'Individual lease — No TDS';
  } else {
    banner.className = 'mode-banner societe';
    bannerText.textContent = `Mixed — ${splitPct}% company (TDS ${tpct}%) · ${100-splitPct}% individual`;
  }

  document.getElementById('r-tds-rate').textContent = tpct + '%';

  const hasTDS = mode !== 'perso';
  const tdsAmount = calcTDS(loyer, tdsRate, mode, splitPct);
  const annualTDS = tdsAmount * 12;
  const netMonthly = loyer - tdsAmount;

  // Split row visibility
  const rowSplit = document.getElementById('row-split');
  if (rowSplit) rowSplit.style.display = mode === 'mixte' ? 'flex' : 'none';
  if (mode === 'mixte') {
    document.getElementById('r-split-pct').textContent = splitPct + '%';
    set('r-split-amt', fmt(loyer * splitPct / 100));
  }

  // Tenant
  set('r-brut', fmt(loyer));
  set('r-tds',    tdsAmount > 0 ? '− ' + fmt(tdsAmount) : 'Rs\u00a00', tdsAmount > 0 ? 'v-red' : 'v-muted');
  set('r-remise', tdsAmount > 0 ? fmt(tdsAmount) : 'Rs\u00a00', tdsAmount > 0 ? 'v-red' : 'v-muted');
  set('r-net', fmt(netMonthly), 'v-green');
  ['row-tds','row-remise'].forEach(id =>
    document.getElementById(id).style.opacity = tdsAmount > 0 ? '1' : '0.35');

  // Owner annual — use actual annualTDS
  const annualRent = loyer * 12;
  const taxWith    = mauritiusTax(otherIncome + annualRent, taxCategory);
  const taxWithout = mauritiusTax(otherIncome, taxCategory);
  const rentalTax  = Math.max(0, taxWith - taxWithout);
  const netTax     = Math.max(0, rentalTax - annualTDS);
  const annualCash = annualRent - rentalTax;
  const effRate    = annualRent > 0 ? rentalTax / annualRent : 0;

  set('r-rental-annual', fmt(annualRent, '\u00a0/ yr'));
  set('r-other-income',  fmt(otherIncome, '\u00a0/ yr'), 'v-muted');
  set('r-total-income',  fmt(otherIncome + annualRent, '\u00a0/ yr'));
  set('r-tax-total',     fmt(taxWith, '\u00a0/ yr'), 'v-red');
  set('r-tax-rental',    fmt(rentalTax, '\u00a0/ yr'), 'v-red');
  set('r-credit',  annualTDS > 0 ? '+ ' + fmt(annualTDS, '\u00a0/ yr') : 'Rs\u00a00', annualTDS > 0 ? 'v-green' : 'v-muted');
  set('r-nettax',        fmt(netTax, '\u00a0/ yr'));
  set('r-effrate',       pct(effRate * 100) + ' on rental', 'v-muted');
  set('r-cashowner',     fmt(annualCash, '\u00a0/ yr'), 'v-green');
  document.getElementById('row-credit').style.opacity = annualTDS > 0 ? '1' : '0.35';

  // Compare — always pure company vs pure individual
  const sc = calcScenario(loyer, tdsRate, true,  splitPct, otherIncome, taxCategory);
  const sp = calcScenario(loyer, tdsRate, false, splitPct, otherIncome, taxCategory);

  set('c-net-soc',  fmt(sc.netMonthly, '\u00a0/ mo'));
  set('c-tds-soc',  fmt(sc.annualTDS,  '\u00a0/ yr'), 'v-red');
  set('c-tax-soc',  fmt(sc.netTax,     '\u00a0/ yr'));
  set('c-cash-soc', fmt(sc.annualCash, '\u00a0/ yr'), 'v-green');
  set('c-net-per',  fmt(sp.netMonthly, '\u00a0/ mo'));
  set('c-tds-per',  'Rs\u00a00', 'v-muted');
  set('c-tax-per',  fmt(sp.netTax,     '\u00a0/ yr'));
  set('c-cash-per', fmt(sp.annualCash, '\u00a0/ yr'), 'v-green');

  const diff = sc.annualCash - sp.annualCash;
  const diffEl = document.getElementById('diff-owner');
  if (Math.abs(diff) < 50) {
    diffEl.textContent = 'Identical — timing differs only';
    diffEl.className = 'val v-muted';
  } else {
    diffEl.textContent = (diff >= 0 ? '+' : '') + fmt(diff) + (diff >= 0 ? ' (company)' : ' (individual)');
    diffEl.className = 'val ' + (diff >= 0 ? 'v-green' : 'v-red');
  }
</script>

</body>
</html>
