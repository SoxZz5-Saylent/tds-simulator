<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>TDS Simulator — Mauritius Rental Tax</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous"/>
<style>
  :root {
    --bg:         #0b0d12;
    --surface:    #13161e;
    --surface2:   #1a1d28;
    --border:     #232637;
    --accent:     #7c6ff7;
    --accent-dim: rgba(124,111,247,0.12);
    --teal:       #0fcfb0;
    --teal-dim:   rgba(15,207,176,0.12);
    --warn:       #f06474;
    --warn-dim:   rgba(240,100,116,0.10);
    --amber:      #f5a623;
    --amber-dim:  rgba(245,166,35,0.10);
    --green:      #3ecf8e;
    --text:       #e2e4ef;
    --text-2:     #9599b3;
    --text-3:     #5c6180;
    --r:          12px;
    --rs:         8px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 15px; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
    min-height: 100vh;
    padding: 40px 20px 64px;
    -webkit-font-smoothing: antialiased;
  }

  /* HEADER */
  .header {
    max-width: 960px;
    margin: 0 auto 32px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .header h1 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .h-icon {
    width: 34px; height: 34px;
    background: var(--accent-dim);
    border: 1px solid rgba(124,111,247,0.28);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    color: var(--accent); font-size: 0.85rem; flex-shrink: 0;
  }
  .header p { margin-top: 5px; font-size: 0.8rem; color: var(--text-2); }
  .mra-btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.73rem; color: var(--text-3);
    text-decoration: none;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 6px; padding: 7px 11px;
    transition: all 0.15s; white-space: nowrap; align-self: flex-start;
  }
  .mra-btn:hover { color: var(--text-2); border-color: var(--accent); }

  /* GRID */
  .grid { max-width: 960px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 680px) { .grid { grid-template-columns: 1fr; } }
  .full { grid-column: 1 / -1; }

  /* CARD */
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r); padding: 20px; }
  .card-title {
    display: flex; align-items: center; gap: 7px;
    font-size: 0.68rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--text-3); margin-bottom: 18px;
  }

  /* FIELD */
  .field { margin-bottom: 16px; }
  .field:last-child { margin-bottom: 0; }
  .field-label {
    font-size: 0.77rem; font-weight: 500; color: var(--text-2);
    margin-bottom: 7px; display: flex; align-items: center; gap: 6px;
  }
  .field-label i { color: var(--text-3); font-size: 0.72rem; }
  .field-hint { font-size: 0.68rem; color: var(--text-3); margin-top: 4px; }

  input[type=number] {
    width: 100%; background: var(--bg);
    border: 1px solid var(--border); border-radius: var(--rs);
    color: var(--text); font-family: 'Inter', sans-serif;
    font-size: 1.1rem; font-weight: 600;
    padding: 10px 14px; outline: none;
    transition: border-color 0.15s;
    -moz-appearance: textfield;
  }
  input[type=number]::-webkit-inner-spin-button { display: none; }
  input[type=number]:focus { border-color: var(--accent); }

  /* SECTION SEPARATOR inside card */
  .section-sep {
    border: none; border-top: 1px solid var(--border);
    margin: 16px 0;
  }
  .section-label {
    font-size: 0.65rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--text-3); margin-bottom: 12px;
    display: flex; align-items: center; gap: 6px;
  }

  /* TOGGLE */
  .toggle-group { display: flex; gap: 6px; }
  .toggle-btn {
    flex: 1; padding: 8px 10px;
    border-radius: var(--rs); border: 1px solid var(--border);
    background: var(--bg); color: var(--text-2);
    font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 500;
    cursor: pointer; transition: all 0.15s;
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .toggle-btn:hover:not(.active) { border-color: var(--accent); color: var(--text); }
  .toggle-btn.active { background: var(--accent-dim); color: var(--accent); border-color: rgba(124,111,247,0.4); font-weight: 600; }
  .toggle-btn.active.teal { background: var(--teal-dim); color: var(--teal); border-color: rgba(15,207,176,0.35); }
  .pill { font-size: 0.6rem; font-weight: 700; padding: 1px 5px; border-radius: 99px; letter-spacing: 0.03em; }
  .pill-red   { background: rgba(240,100,116,0.15); color: var(--warn); }
  .pill-green { background: rgba(62,207,142,0.15);  color: var(--green); }

  /* MODE BANNER */
  .mode-banner {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 12px; border-radius: var(--rs);
    font-size: 0.78rem; font-weight: 600; margin-bottom: 14px; transition: all 0.2s;
  }
  .mode-banner.societe { background: var(--accent-dim); color: var(--accent); border: 1px solid rgba(124,111,247,0.22); }
  .mode-banner.perso   { background: var(--teal-dim);   color: var(--teal);   border: 1px solid rgba(15,207,176,0.22); }

  /* RESULT BLOCKS */
  .rblock { border-radius: var(--rs); padding: 13px 15px; margin-bottom: 10px; }
  .rblock:last-child { margin-bottom: 0; }
  .rblock.b-accent { background: var(--accent-dim); border: 1px solid rgba(124,111,247,0.18); }
  .rblock.b-teal   { background: var(--teal-dim);   border: 1px solid rgba(15,207,176,0.18); }
  .rblock.b-amber  { background: var(--amber-dim);  border: 1px solid rgba(245,166,35,0.18); }
  .rblock.b-warn   { background: var(--warn-dim);   border: 1px solid rgba(240,100,116,0.18); }
  .rblock.b-neutral{ background: var(--surface2);   border: 1px solid var(--border); }

  .block-title {
    font-size: 0.67rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    margin-bottom: 11px; display: flex; align-items: center; gap: 6px;
  }
  .block-title.c-accent { color: var(--accent); }
  .block-title.c-teal   { color: var(--teal); }
  .block-title.c-amber  { color: var(--amber); }

  .rrow {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 8px; padding: 4px 0; font-size: 0.82rem;
  }
  .rrow + .rrow { border-top: 1px solid rgba(255,255,255,0.04); }
  .rrow.strong .lbl,
  .rrow.strong .val { font-weight: 700; }
  .rrow .lbl { color: var(--text-2); }
  .rrow .sub { font-size: 0.68rem; color: var(--text-3); }
  .rrow .val { font-weight: 600; white-space: nowrap; }
  .v-accent { color: var(--accent); }
  .v-teal   { color: var(--teal); }
  .v-red    { color: var(--warn); }
  .v-green  { color: var(--green); }
  .v-amber  { color: var(--amber); }
  .v-muted  { color: var(--text-3); }

  /* INSET row (indented) */
  .rrow.indent .lbl { padding-left: 14px; color: var(--text-3); font-size: 0.78rem; }
  .rrow.indent .val { font-size: 0.78rem; }

  /* COMPARE */
  .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
  @media (max-width: 500px) { .compare-grid { grid-template-columns: 1fr; } }

  /* NOTE */
  .note {
    font-size: 0.72rem; color: var(--text-3); line-height: 1.65;
    margin-top: 14px; border-left: 2px solid var(--border); padding-left: 12px;
  }
  .note strong { color: var(--text-2); }
  .note a { color: var(--text-3); }
  .note a:hover { color: var(--text-2); }

  /* DIVIDER */
  .div-row { border: none; border-top: 1px dashed rgba(255,255,255,0.07); margin: 6px 0; }
</style>
</head>
<body>

<div class="header">
  <div>
    <h1>
      <span class="h-icon"><i class="fa-solid fa-landmark"></i></span>
      TDS Simulator — Mauritius Rental
    </h1>
    <p>Tax Deduction at Source on rental income &mdash; Company vs Individual &middot; MRA 2025</p>
  </div>
  <a class="mra-btn" href="https://www.mra.mu/download/TDSGuide.pdf" target="_blank" rel="noopener">
    <i class="fa-solid fa-file-lines"></i> MRA TDS Guide 2025 <i class="fa-solid fa-arrow-up-right-from-square"></i>
  </a>
</div>

<div class="grid">

  <!-- ── INPUTS ── -->
  <div class="card">
    <div class="card-title"><i class="fa-solid fa-sliders"></i> Parameters</div>

    <div class="field">
      <div class="field-label"><i class="fa-solid fa-coins"></i> Monthly gross rent (MUR)</div>
      <input type="number" id="loyer" value="125000" min="0" step="1000"/>
    </div>

    <div class="field">
      <div class="field-label"><i class="fa-solid fa-building-user"></i> Tenant type</div>
      <div class="toggle-group">
        <button class="toggle-btn active" id="btn-societe" onclick="setMode('societe')">
          <i class="fa-solid fa-building"></i> Company <span class="pill pill-red">TDS</span>
        </button>
        <button class="toggle-btn" id="btn-perso" onclick="setMode('perso')">
          <i class="fa-solid fa-person"></i> Individual <span class="pill pill-green">No TDS</span>
        </button>
      </div>
    </div>

    <div class="field">
      <div class="field-label"><i class="fa-solid fa-house"></i> Owner residency</div>
      <div class="toggle-group">
        <button class="toggle-btn active" id="btn-resident" onclick="setOwner('resident')">
          <i class="fa-solid fa-flag"></i> Resident &nbsp;<small style="color:var(--text-3);font-size:0.7rem;">7.5%</small>
        </button>
        <button class="toggle-btn" id="btn-nonresident" onclick="setOwner('nonresident')">
          <i class="fa-solid fa-earth-africa"></i> Non-resident &nbsp;<small style="color:var(--text-3);font-size:0.7rem;">10%</small>
        </button>
      </div>
    </div>

    <hr class="section-sep"/>
    <div class="section-label"><i class="fa-solid fa-user-tie"></i> Owner fiscal profile</div>

    <div class="field">
      <div class="field-label"><i class="fa-solid fa-briefcase"></i> Other annual income (MUR)</div>
      <input type="number" id="otherIncome" value="0" min="0" step="50000"/>
      <div class="field-hint">Salary, business, other — excluding this rental</div>
    </div>

    <div class="field">
      <div class="field-label"><i class="fa-solid fa-users"></i> Tax category</div>
      <div class="toggle-group">
        <button class="toggle-btn active" id="btn-catA" onclick="setCategory('A')">
          <i class="fa-solid fa-user"></i> Cat. A <small style="color:var(--text-3);font-size:0.68rem;">Rs 390k exempt</small>
        </button>
        <button class="toggle-btn" id="btn-catB" onclick="setCategory('B')">
          <i class="fa-solid fa-user-plus"></i> Cat. B <small style="color:var(--text-3);font-size:0.68rem;">Rs 390k+ exempt</small>
        </button>
      </div>
      <div class="field-hint">Cat. A = single / no dependent. Cat. B = with dependents (exemption varies — use as estimate)</div>
    </div>
  </div>

  <!-- ── RESULTS ── -->
  <div class="card">
    <div class="card-title"><i class="fa-solid fa-chart-pie"></i> Results</div>

    <div id="modeBanner" class="mode-banner societe">
      <i class="fa-solid fa-circle-check"></i>
      <span id="bannerText">Company lease — TDS 7.5% applicable</span>
    </div>

    <!-- Tenant cash flow (monthly) -->
    <div class="rblock b-accent">
      <div class="block-title c-accent"><i class="fa-solid fa-building"></i> Tenant — monthly cash flow</div>
      <div class="rrow"><span class="lbl">Gross rent</span><span class="val v-accent" id="r-brut">—</span></div>
      <div class="rrow" id="row-tds">
        <span class="lbl">TDS withheld <span class="sub" id="r-tds-rate">7.5%</span></span>
        <span class="val v-red" id="r-tds">—</span>
      </div>
      <div class="rrow" id="row-remise">
        <span class="lbl">Remitted to MRA <span class="sub">before 20th</span></span>
        <span class="val v-red" id="r-remise">—</span>
      </div>
      <div class="rrow strong">
        <span class="lbl">Net paid to owner</span>
        <span class="val v-green" id="r-net">—</span>
      </div>
    </div>

    <!-- Owner fiscal (annual) -->
    <div class="rblock b-teal">
      <div class="block-title c-teal"><i class="fa-solid fa-key"></i> Owner — annual fiscal analysis</div>
      <div class="rrow"><span class="lbl">Rental income</span><span class="val v-teal" id="r-rental-annual">—</span></div>
      <div class="rrow"><span class="lbl">Other income</span><span class="val v-muted" id="r-other-income">—</span></div>
      <div class="rrow strong"><span class="lbl">Total annual income</span><span class="val v-teal" id="r-total-income">—</span></div>
      <hr class="div-row"/>
      <div class="rrow"><span class="lbl">Tax on total income <span class="sub">MRA approx.</span></span><span class="val v-red" id="r-tax-total">—</span></div>
      <div class="rrow indent"><span class="lbl"><i class="fa-solid fa-arrow-right" style="font-size:0.6rem"></i> Of which: on rental (marginal)</span><span class="val v-red" id="r-tax-rental">—</span></div>
      <div class="rrow" id="row-credit"><span class="lbl">TDS credit (advance paid)</span><span class="val v-green" id="r-credit">—</span></div>
      <div class="rrow strong"><span class="lbl">Net tax to settle (annual)</span><span class="val v-amber" id="r-nettax">—</span></div>
      <div class="rrow indent"><span class="lbl">Effective rate on rental</span><span class="val v-muted" id="r-effrate">—</span></div>
      <hr class="div-row"/>
      <div class="rrow strong"><span class="lbl">Owner net cash-in (annual)</span><span class="val v-green" id="r-cashowner">—</span></div>
    </div>
  </div>

  <!-- ── COMPARISON ── -->
  <div class="card full">
    <div class="card-title"><i class="fa-solid fa-scale-balanced"></i> Comparison — Company vs Individual</div>

    <div class="compare-grid">
      <div class="rblock b-accent">
        <div class="block-title c-accent"><i class="fa-solid fa-building"></i> Company lease</div>
        <div class="rrow"><span class="lbl">Monthly to owner</span><span class="val v-accent" id="c-net-soc">—</span></div>
        <div class="rrow"><span class="lbl">Annual TDS → MRA</span><span class="val v-red" id="c-tds-soc">—</span></div>
        <div class="rrow"><span class="lbl">Net tax to settle</span><span class="val v-amber" id="c-tax-soc">—</span></div>
        <div class="rrow strong"><span class="lbl">Annual cash-in</span><span class="val v-green" id="c-cash-soc">—</span></div>
      </div>
      <div class="rblock b-teal">
        <div class="block-title c-teal"><i class="fa-solid fa-person"></i> Individual lease</div>
        <div class="rrow"><span class="lbl">Monthly to owner</span><span class="val v-teal" id="c-net-per">—</span></div>
        <div class="rrow"><span class="lbl">Annual TDS → MRA</span><span class="val v-muted" id="c-tds-per">—</span></div>
        <div class="rrow"><span class="lbl">Net tax to settle</span><span class="val v-amber" id="c-tax-per">—</span></div>
        <div class="rrow strong"><span class="lbl">Annual cash-in</span><span class="val v-green" id="c-cash-per">—</span></div>
      </div>
    </div>

    <div class="rblock b-amber">
      <div class="block-title c-amber"><i class="fa-solid fa-arrow-right-arrow-left"></i> Differential (annual cash-in)</div>
      <div class="rrow">
        <span class="lbl">Cash-in advantage<span class="sub">TDS = tax advance; recoverable if TDS &gt; tax due</span></span>
        <span class="val" id="diff-owner">—</span>
      </div>
      <div class="rrow">
        <span class="lbl">Tenant cost impact</span>
        <span class="val v-muted">Identical — TDS is a tax routing, not an extra charge</span>
      </div>
    </div>

    <p class="note">
      <strong>Approx. brackets used:</strong> Rs 390,000 exemption (Cat. A) · 15% flat rate · +5% solidarity levy above Rs 3M ·
      marginal attribution = tax(rental + other) − tax(other only).<br/>
      TDS does not apply if tenant turnover &lt; Rs 6M, or if calculated tax &lt; Rs 500.
      Source: <a href="https://www.mra.mu/download/TDSGuide.pdf" target="_blank" rel="noopener">MRA TDS Guide 2025</a> — consult a tax advisor for exact figures.
    </p>
  </div>

</div>

<script>
let mode = 'societe', ownerType = 'resident', taxCategory = 'A';

// ── Mauritius income tax approximation ──
function mauritiusTax(income, category) {
  if (income <= 0) return 0;
  // Category A exemption Rs 390,000; Category B ~ Rs 500,000 (midpoint estimate, varies by dependents)
  const exempt = category === 'B' ? 500000 : 390000;
  const taxable = Math.max(0, income - exempt);
  let tax = taxable * 0.15;
  // Solidarity levy: 5% additional on income exceeding Rs 3,000,000
  if (income > 3000000) {
    tax += (income - 3000000) * 0.05;
  }
  return Math.max(0, tax);
}

function setMode(m) {
  mode = m;
  ['societe','perso'].forEach(x =>
    document.getElementById('btn-'+x).classList.toggle('active', m === x));
  update();
}
function setOwner(o) {
  ownerType = o;
  ['resident','nonresident'].forEach(x => {
    const btn = document.getElementById('btn-'+x);
    btn.classList.toggle('active', o === x);
    btn.classList.toggle('teal', o === x && x === 'nonresident');
  });
  update();
}
function setCategory(c) {
  taxCategory = c;
  ['A','B'].forEach(x =>
    document.getElementById('btn-cat'+x).classList.toggle('active', c === x));
  update();
}

function fmt(n, suffix='') {
  const abs = Math.abs(Math.round(n));
  return (n < 0 ? '− ' : '') + 'Rs\u00a0' + abs.toLocaleString('fr-FR') + suffix;
}
function pct(n) { return Math.round(n * 10) / 10 + '%'; }

function calcScenario(loyer, tdsRate, hasTDS, otherIncome, category) {
  const annualRent = loyer * 12;
  const annualTDS  = hasTDS ? annualRent * tdsRate : 0;
  const netMonthly = loyer - (hasTDS ? loyer * tdsRate : 0);

  const taxWithRent    = mauritiusTax(otherIncome + annualRent, category);
  const taxWithoutRent = mauritiusTax(otherIncome, category);
  const rentalTax      = Math.max(0, taxWithRent - taxWithoutRent);

  const netTaxToSettle = Math.max(0, rentalTax - annualTDS);
  // If annualTDS > rentalTax, excess is refunded by MRA → cash-in = annualRent - annualTDS + refund - 0
  // Net: cash-in = annualRent - rentalTax (regardless of TDS direction, final is same)
  const annualCashIn = annualRent - rentalTax;
  const effRate = annualRent > 0 ? rentalTax / annualRent : 0;

  return { annualRent, annualTDS, netMonthly, taxWithRent, rentalTax, netTaxToSettle, annualCashIn, effRate };
}

function update() {
  const loyer = parseFloat(document.getElementById('loyer').value) || 0;
  const otherIncome = parseFloat(document.getElementById('otherIncome').value) || 0;
  const tdsRate = ownerType === 'resident' ? 0.075 : 0.10;
  const hasTDS  = mode === 'societe';

  document.getElementById('r-tds-rate').textContent = (tdsRate * 100) + '%';

  const banner = document.getElementById('modeBanner');
  const bannerText = document.getElementById('bannerText');
  if (hasTDS) {
    banner.className = 'mode-banner societe';
    bannerText.textContent = 'Company lease — TDS ' + (tdsRate * 100) + '% applicable';
  } else {
    banner.className = 'mode-banner perso';
    bannerText.textContent = 'Individual lease — No TDS';
  }

  const s = calcScenario(loyer, tdsRate, hasTDS, otherIncome, taxCategory);

  // Tenant (monthly)
  document.getElementById('r-brut').textContent  = fmt(loyer);
  document.getElementById('r-tds').textContent   = hasTDS ? '− ' + fmt(loyer * tdsRate) : 'Rs\u00a00';
  document.getElementById('r-remise').textContent= hasTDS ? fmt(loyer * tdsRate) : 'Rs\u00a00';
  document.getElementById('r-net').textContent   = fmt(s.netMonthly);
  ['row-tds','row-remise'].forEach(id =>
    document.getElementById(id).style.opacity = hasTDS ? '1' : '0.38');

  // Owner (annual)
  document.getElementById('r-rental-annual').textContent = fmt(s.annualRent, '\u00a0/ yr');
  document.getElementById('r-other-income').textContent  = fmt(otherIncome, '\u00a0/ yr');
  document.getElementById('r-total-income').textContent  = fmt(otherIncome + s.annualRent, '\u00a0/ yr');
  document.getElementById('r-tax-total').textContent     = fmt(s.taxWithRent, '\u00a0/ yr');
  document.getElementById('r-tax-rental').textContent    = fmt(s.rentalTax, '\u00a0/ yr');
  document.getElementById('r-credit').textContent        = hasTDS ? '+ ' + fmt(s.annualTDS, '\u00a0/ yr') : 'Rs\u00a00';
  document.getElementById('r-nettax').textContent        = fmt(s.netTaxToSettle, '\u00a0/ yr');
  document.getElementById('r-effrate').textContent       = pct(s.effRate * 100) + ' on rental';
  document.getElementById('r-cashowner').textContent     = fmt(s.annualCashIn, '\u00a0/ yr');
  document.getElementById('row-credit').style.opacity = hasTDS ? '1' : '0.38';

  // Comparison — always compute both scenarios
  const sc = calcScenario(loyer, tdsRate, true,  otherIncome, taxCategory); // company
  const sp = calcScenario(loyer, tdsRate, false, otherIncome, taxCategory); // individual

  document.getElementById('c-net-soc').textContent  = fmt(sc.netMonthly, '\u00a0/ mo');
  document.getElementById('c-tds-soc').textContent  = fmt(sc.annualTDS, '\u00a0/ yr');
  document.getElementById('c-tax-soc').textContent  = fmt(sc.netTaxToSettle, '\u00a0/ yr');
  document.getElementById('c-cash-soc').textContent = fmt(sc.annualCashIn, '\u00a0/ yr');

  document.getElementById('c-net-per').textContent  = fmt(sp.netMonthly, '\u00a0/ mo');
  document.getElementById('c-tds-per').textContent  = 'Rs\u00a00';
  document.getElementById('c-tax-per').textContent  = fmt(sp.netTaxToSettle, '\u00a0/ yr');
  document.getElementById('c-cash-per').textContent = fmt(sp.annualCashIn, '\u00a0/ yr');

  // Differential (annual cash-in company − individual = 0 always in theory since tax is the same)
  // The real diff is *timing*: TDS smooths it monthly vs lump-sum in individual
  const diff = sc.annualCashIn - sp.annualCashIn;
  const diffEl = document.getElementById('diff-owner');
  if (Math.abs(diff) < 50) {
    diffEl.textContent = 'Identical final cash-in — timing differs (TDS smooths monthly vs annual settlement)';
    diffEl.className = 'val v-muted';
  } else {
    diffEl.textContent = (diff >= 0 ? '+' : '') + fmt(diff) + (diff >= 0 ? ' (company lease)' : ' (individual lease)');
    diffEl.className = 'val ' + (diff >= 0 ? 'v-green' : 'v-red');
  }
}

update();
['loyer','otherIncome'].forEach(id =>
  document.getElementById(id).addEventListener('input', update));
</script>
</body>
</html>
